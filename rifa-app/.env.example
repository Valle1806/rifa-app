VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (preset sin firma, restringido a imágenes de máx. 5 MB y sin sobrescritura)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# App Check con reCAPTCHA v3 (opcional pero recomendado). Sin esta clave App Check no se activa.
VITE_RECAPTCHA_SITE_KEY=
# Token de depuración de App Check registrado en la consola, solo para desarrollo local.
VITE_APPCHECK_DEBUG_TOKEN=
