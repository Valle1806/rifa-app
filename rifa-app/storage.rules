rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para verificar si el usuario es administrador
    function isAdmin() {
      return request.auth != null;
    }

    // Reglas para los comprobantes de pago
    match /receipts/{raffleId}/{ticketId}/{allPaths=**} {
      // Solo el admin puede ver los comprobantes
      allow read: if isAdmin();
      // Cualquiera puede subir un comprobante al reservar (opcional, según flujo)
      // O solo el admin si el flujo es manual
      allow write: if true; // Permitimos subida, pero la lectura es restringida
    }
    
    // Denegar todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
